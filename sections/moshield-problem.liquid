{% schema %}
{
  "name": "MoShield Problem",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Mosquitoes Ruin Great Moments"
    }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Scenario",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Scenario Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoShield Problem",
      "blocks": [
        { "type": "scenario", "settings": { "title": "Camping" } },
        { "type": "scenario", "settings": { "title": "Travel" } },
        { "type": "scenario", "settings": { "title": "Gardening" } },
        { "type": "scenario", "settings": { "title": "Outdoor Dining" } }
      ]
    }
  ]
}
{% endschema %}

<div class="moshield-section" style="padding-top: 4rem;">
  <div style="text-align: center; margin-bottom: 4rem;">
    <h2 class="moshield-title-large">{{ section.settings.headline }}</h2>
  </div>
  
  <div class="moshield-grid moshield-grid-2" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
    {% for block in section.blocks %}
      <div class="moshield-glass-card" style="text-align: center; padding: 3rem 2rem;" {{ block.shopify_attributes }}>
        <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--moshield-text-primary); color: #fff; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
        </div>
        <h3 class="moshield-title-medium" style="margin: 0;">{{ block.settings.title }}</h3>
      </div>
    {% endfor %}
  </div>
</div>
