{% schema %}
{
  "name": "MoShield How It Works",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Large Product Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Simple Protection. Every Day."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Step Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoShield How It Works",
      "blocks": [
        { "type": "step", "settings": { "text": "Wear the bracelet." } },
        { "type": "step", "settings": { "text": "Enjoy outdoor activities." } },
        { "type": "step", "settings": { "text": "Stay protected longer." } }
      ]
    }
  ]
}
{% endschema %}

<div class="moshield-section" style="text-align: center; padding-top: 8rem; padding-bottom: 8rem;">
  
  <div class="moshield-img-wrapper" style="max-width: 800px; margin: 0 auto 6rem; height: 500px; border: none; background: transparent; box-shadow: none;">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | img_url: '1000x' }}" alt="How MoShield Works" style="object-fit: contain;">
    {% else %}
      <div style="width: 100%; height: 100%; background: var(--moshield-glass-bg); border-radius: var(--moshield-radius-lg); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(20px); border: 1px solid var(--moshield-glass-border);">
        <span style="color: var(--moshield-text-secondary); font-size: 1.25rem;">Large Product Flow Image Placeholder</span>
      </div>
    {% endif %}
  </div>

  <h2 class="moshield-title-massive" style="margin-bottom: 6rem; max-width: 800px; margin-left: auto; margin-right: auto;">
    {{ section.settings.headline }}
  </h2>

  <div class="moshield-grid moshield-grid-3" style="max-width: 1000px; margin: 0 auto;">
    {% for block in section.blocks %}
      <div class="moshield-glass-card" style="padding: 3rem; text-align: left;" {{ block.shopify_attributes }}>
        <div style="font-size: 1.25rem; font-weight: 700; color: var(--moshield-text-secondary); margin-bottom: 1rem;">
          Step {{ forloop.index }}
        </div>
        <div class="moshield-title-medium" style="line-height: 1.3;">
          {{ block.settings.text }}
        </div>
      </div>
    {% endfor %}
  </div>

</div>
