{% schema %}
{
  "name": "MoShield Benefits",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Protection That Moves With You"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoShield Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Comfortable All-Day Wear" } },
        { "type": "benefit", "settings": { "title": "Water Resistant" } },
        { "type": "benefit", "settings": { "title": "Adjustable Fit" } },
        { "type": "benefit", "settings": { "title": "Family Friendly" } },
        { "type": "benefit", "settings": { "title": "Outdoor Ready" } },
        { "type": "benefit", "settings": { "title": "Travel Essential" } }
      ]
    }
  ]
}
{% endschema %}

<div class="moshield-section" style="padding-top: 4rem;">
  <div style="text-align: center; margin-bottom: 4rem;">
    <h2 class="moshield-title-large">{{ section.settings.headline }}</h2>
  </div>
  
  <div class="moshield-grid moshield-grid-3">
    {% for block in section.blocks %}
      <div class="moshield-glass-card" style="display: flex; flex-direction: column; justify-content: center; min-height: 200px;" {{ block.shopify_attributes }}>
        <h3 class="moshield-title-medium" style="margin: 0;">{{ block.settings.title }}</h3>
      </div>
    {% endfor %}
  </div>
</div>
