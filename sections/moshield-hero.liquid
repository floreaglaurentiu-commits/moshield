{% schema %}
{
  "name": "MoShield Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MoShield"
    },
    {
      "type": "text",
      "id": "subheading_1",
      "label": "Subheading Line 1",
      "default": "Mosquito Protection."
    },
    {
      "type": "text",
      "id": "subheading_2",
      "label": "Subheading Line 2",
      "default": "Reimagined."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Comfortable protection for every outdoor moment."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Button 1 Text",
      "default": "Protect Yourself Today"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Button 2 Text",
      "default": "See How It Works"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Button 2 Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoShield Hero",
      "blocks": [
        { "type": "feature", "settings": { "title": "Chemical-Free Comfort" } },
        { "type": "feature", "settings": { "title": "Long Lasting Protection" } },
        { "type": "feature", "settings": { "title": "Lightweight & Waterproof" } }
      ]
    }
  ]
}
{% endschema %}

{{ 'moshield-premium.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moshield-premium.js' | asset_url }}" defer></script>

<div class="moshield-section moshield-hero-section">
  <div class="moshield-grid moshield-grid-2" style="align-items: center;">
    
    <div class="moshield-hero-content">
      <h1 class="moshield-title-massive">
        {{ section.settings.heading }}<br>
        <span style="color: var(--moshield-text-secondary); font-size: 0.6em; font-weight: 600; display: block; margin-top: 0.5rem; line-height: 1.1;">
          {{ section.settings.subheading_1 }}<br>
          {{ section.settings.subheading_2 }}
        </span>
      </h1>
      
      <p class="moshield-subtitle">{{ section.settings.description }}</p>
      
      <div class="moshield-hero-cards">
        {% for block in section.blocks %}
          <div class="moshield-glass-card moshield-hero-card" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            <span style="font-weight: 600; font-size: 1.125rem;">{{ block.settings.title }}</span>
          </div>
        {% endfor %}
      </div>
      
      <div class="moshield-hero-actions">
        <a href="{{ section.settings.btn_1_link | default: '#purchase' }}" class="moshield-btn moshield-btn-primary">
          {{ section.settings.btn_1_text }}
        </a>
        <a href="{{ section.settings.btn_2_link | default: '#how-it-works' }}" class="moshield-btn moshield-btn-secondary">
          {{ section.settings.btn_2_text }}
        </a>
      </div>
    </div>
    
    <div class="moshield-hero-image-container">
      {% if section.settings.product_image %}
        <img src="{{ section.settings.product_image | img_url: '1200x' }}" alt="MoShield Bracelet" class="moshield-hero-image">
      {% else %}
        <div style="width: 100%; height: 600px; background: var(--moshield-glass-bg); border: 1px solid var(--moshield-glass-border); border-radius: var(--moshield-radius-lg); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(20px);">
          <span style="color: var(--moshield-text-secondary); font-size: 1.25rem;">Premium Product Render Placeholder</span>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<!-- Sticky Mobile Buy Button -->
<div class="moshield-sticky-bar">
  <div>
    <span style="display: block; font-weight: 700; color: var(--moshield-text-primary);">MoShield</span>
    <span style="font-size: 0.875rem; color: var(--moshield-text-secondary);">Protection Reimagined</span>
  </div>
  <a href="#purchase" class="moshield-btn moshield-btn-primary" style="padding: 0.75rem 1.5rem;">Buy Now</a>
</div>
